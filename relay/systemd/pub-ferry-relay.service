# Pub Ferry の受信ホスト（Linux VPS 用）
#
# tailscaled より後に起動する。起動直後の tailscaled はまだアドレスを
# 答えないことがあり、そのとき relay は「アドレスが取れない」で終了する
# ——設計どおりに、0.0.0.0 へ落ちるかわりに。だから再試行が要る。
#
#   sudo cp relay/systemd/pub-ferry-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pub-ferry-relay

[Unit]
Description=Pub Ferry optical transfer relay host
Documentation=file:///opt/pub-ferry/docs/relay/SETUP.md
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=pub-ferry
Group=pub-ferry
WorkingDirectory=/opt/pub-ferry
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run relay -- serve
Restart=on-failure
RestartSec=10s
# Give up telling systemd about it after this many attempts in this window, so
# a genuinely broken configuration is visible in `systemctl status` instead of
# scrolling past in a loop for ever.
StartLimitBurst=10
StartLimitIntervalSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
# The relay writes exactly two places: its own configuration and state, and the
# folders its owner registered as receive routes. Everything else is read-only.
ReadWritePaths=/home/pub-ferry/.config/pub-ferry /srv/pub-ferry-inbox
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
