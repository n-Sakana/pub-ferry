<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <AssemblyName>ferry</AssemblyName>
    <RootNamespace>Ferry</RootNamespace>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);archive/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="web/index.html" LogicalName="Ferry.Web.index.html" />
    <EmbeddedResource Include="web/app.css" LogicalName="Ferry.Web.app.css" />
    <EmbeddedResource Include="web/app.js" LogicalName="Ferry.Web.app.js" />
    <EmbeddedResource Include="web/icon.svg" LogicalName="Ferry.Web.icon.svg" />
  </ItemGroup>
</Project>
